// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Example model
model User {
  id             String      @id @default(uuid())
  email          String   @unique
  password       String
  name           String
  isVerified     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt @default(now())
  verificationToken String?
  verificationTokenExpiry DateTime?
  resetPasswordToken String?
  resetPasswordTokenExpiry DateTime?
  sessions        Session[]
}


model Session {
  id               String   @id @default(uuid()) // session ID / token ID
  userId           String
  user             User     @relation(fields: [userId], references: [id])
  ip               String?  // client IP
  userAgent        String?  // raw user agent string
  deviceType       String?  // 'desktop', 'laptop', 'tablet', 'phone', etc.
  browser          String?  // parsed browser name (Chrome, Safari, etc.)
  os               String?  // operating system (Windows, MacOS, Android, iOS)
  city            String?  // geolocation city
  region          String?  // geolocation region/state
  country         String?  // geolocation country
  lastSeen         DateTime @default(now())
  createdAt        DateTime @default(now())
  expiresAt        DateTime
  // revokedAt        DateTime?
  refreshTokenHash String?  // hashed refresh token
}
